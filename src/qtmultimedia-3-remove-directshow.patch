-bool VideoSurfaceInputPin::setMediaType(const AM_MEDIA_TYPE *type)
-{
-    if (!DirectShowInputPin::setMediaType(type))
-        return false;
-
-    return m_videoSurfaceFilter->setMediaType(type);
-}
