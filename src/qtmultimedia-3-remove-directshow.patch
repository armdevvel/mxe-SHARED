-void DirectShowPlayerControl::setVolume(int volume)
-{
-    int boundedVolume = qBound(0, volume, 100);
-
-    if (m_volume == boundedVolume)
-        return;
-
-    m_volume = boundedVolume;
-
-    if (!m_muted)
-        setVolumeHelper(m_volume);
-
-    emit volumeChanged(m_volume);
-}
