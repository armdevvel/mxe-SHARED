-HRESULT DirectShowPin::QueryId(LPWSTR *Id)
-{
-    if (!Id)
-        return E_POINTER;
-    const int bytes = (m_name.length() + 1) * 2;
-    *Id = static_cast<LPWSTR>(::CoTaskMemAlloc(bytes));
-    ::memcpy(*Id, m_name.utf16(), bytes);
-    return S_OK;
