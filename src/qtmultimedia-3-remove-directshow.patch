-                            if (SUCCEEDED(pStore->GetValue(PKEY_Video_VerticalAspectRatio, &var)))
-                                aspectRatio.setHeight(convertValue(var).toUInt());
-                            metadata.insert(QMediaMetaData::PixelAspectRatio, aspectRatio);
