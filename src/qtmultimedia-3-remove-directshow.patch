-void DirectShowIOSource::setAllocator(IMemAllocator *allocator)
-{
-    if (m_allocator == allocator)
-        return;
-
-    if (m_allocator)
-        m_allocator->Release();
-
-    m_allocator = allocator;
-
-    if (m_allocator)
-        m_allocator->AddRef();
